config interface 'loopback'
        option device 'lo'
        option proto 'static'
        option ipaddr '127.0.0.1'
        option netmask '255.0.0.0'

config globals 'globals'
        option ula_prefix 'fd7b:29a0:6359::/48'
        option packet_steering '1'

config device
        option name 'br-lan'
        option type 'bridge'
        list ports 'lan1'
        list ports 'lan2'
        list ports 'lan3'

config interface 'lan'
        option device 'br-lan'
        option proto 'static'
        option ipaddr '192.168.1.1'
        option netmask '255.255.255.0'
        option ip6assign '60'

config interface 'wan'
        option device 'wan'
        option proto 'dhcp'

config interface 'wan6'
        option device 'wan'
        option proto 'dhcpv6'

config device
        option name '/dev/cdc-wdm0'

config interface 'wwan0'
        option proto 'modemmanager'
        option iptype 'ipv4v6'
        option loglevel 'ERR'
        option device '/sys/devices/platform/1e1c0000.xhci/usb1/1-2'
        option apn 'www'
        list allowedauth 'pap'
        list allowedauth 'chap'